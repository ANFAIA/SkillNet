# Secrets & local config
.env
*.local
# Per-machine agent instructions: absolute paths, local model servers, OS-specific
# workarounds. `*.local` above does not match this, and CLAUDE.md ships to everyone who
# clones — a stranger's agent following someone else's paths is worse than no instructions.
CLAUDE.local.md

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/
*.tsbuildinfo

# Data
apps/skillnet-api/uploads/
# Generated media assets (podcast mp3, infographic/cover png, video mp4) — runtime, deduped
# on disk by content hash, never source.
apps/skillnet-api/data/media_assets/
backups/
# Output of scripts/quality_bench.py: run summaries and raw model dumps.
apps/skillnet-api/bench_out/
# Runtime-generated TTS responses.
apps/skillnet-api/data/tts_cache/

# Agent workspace
.claude/
.opencode/
.codex-evidence/
.pnpm-store/
tmp/
apps/skillnet-api/.tmp-*/
apps/skillnet-api/.pytest-*/
AGENTS.md
CLAUDE.md

