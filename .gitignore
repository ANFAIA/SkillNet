# Secrets & local config
.env
*.local
# Per-machine agent instructions: absolute paths, local model servers, OS-specific
# workarounds. `*.local` above does not match this, and CLAUDE.md ships to everyone who
# clones — a stranger's agent following someone else's paths is worse than no instructions.
CLAUDE.local.md

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/
*.tsbuildinfo

# Data
apps/skillnet-api/uploads/
# Generated media assets (podcast mp3, infographic/cover png, video mp4) — runtime, deduped
# on disk by content hash, never source.
apps/skillnet-api/data/media_assets/
backups/
# Output of scripts/quality_bench.py: run summaries and raw model dumps.
apps/skillnet-api/bench_out/
# Runtime-generated TTS responses.
apps/skillnet-api/data/tts_cache/

# Agent workspace
.claude/
.opencode/
.codex-evidence/
.pnpm-store/
tmp/
/.pytest-*/
apps/skillnet-api/.tmp-*/
apps/skillnet-api/.pytest-*/

# Internal working output: quality-bench campaign reports, journey dumps, per-session
# PLAN/STATUS notes, and the browser screenshots and sweep reports under
# docs/evidencia-testing. Useful while working, noise for anyone who clones — and the
# source of the 148-character paths that broke `git clone` on Windows. Still on disk,
# just not versioned; git history keeps what was already committed.
output/
docs/evidencia-testing/
# AGENTS.md is deliberately NOT ignored: README.md and RUNNING.md link to it as the
# project's conventions, so it has to exist for anyone who clones. CLAUDE.md stays local
# (working notes), and CLAUDE.local.md above stays local too (per-machine paths).
CLAUDE.md

# Editor / OS
.DS_Store
.idea/
.vscode/
