# The only place the GitHub token lives. Fine-grained token, Issues: read and write,
# on the one repository.
GITHUB_TOKEN=
GITHUB_REPO=ANFAIA/SkillNet

# The model that reads each report. Give it its own key, with a spend limit.
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=

# Switch the whole relay off without redeploying.
# ENABLED=true

# GLOBAL_DAILY_CAP=200
# INSTANCE_DAILY_CAP=20
# IP_HOURLY_CAP=10
# RAW_RETENTION_DAYS=30
