---
import type { Claim } from '../lib/site'

interface Props {
  claim: Claim
}

const { claim } = Astro.props
const reviewed = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(new Date(`${claim.reviewedAt}T00:00:00Z`))
---

<article class="claim-panel" data-claim-id={claim.id}>
  <div class="claim-meta">
    <span class="status-tag">Current scope</span>
    <span>Reviewed {reviewed}</span>
  </div>
  <p class="claim-wording">{claim.publicWording}</p>
  <details>
    <summary>Evidence and limits</summary>
    <div class="claim-details">
      <p><strong>Repository records:</strong> {claim.sourceRefs.join(', ')}</p>
      <ul>
        {claim.limitations.map((limitation) => <li>{limitation}</li>)}
      </ul>
    </div>
  </details>
</article>
