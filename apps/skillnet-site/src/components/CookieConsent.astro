---
import type { Locale } from "../i18n/config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy =
  lang === "en"
    ? {
        title: "Analytics cookies",
        body: "SkillNet uses third-party Google Analytics cookies to measure how the website is used and compile statistics. They are only activated if you accept them.",
        reject: "Reject",
        accept: "Accept",
      }
    : {
        title: "Cookies analíticas",
        body: "SkillNet utiliza cookies de terceros de Google Analytics para medir cómo se usa la web y elaborar estadísticas. Solo se activan si las aceptas.",
        reject: "Rechazar",
        accept: "Aceptar",
      };
---

<aside
  data-cookie-consent
  data-state="closed"
  data-theme="light"
  class="cookie-consent fixed inset-x-3 bottom-3 z-[100] mx-auto hidden max-w-3xl flex-col rounded-xl border p-4 backdrop-blur-xl backdrop-saturate-150 sm:bottom-5 sm:flex-row sm:items-center sm:gap-6 sm:px-5 sm:py-3"
  role="region"
  tabindex="-1"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-description"
>
  <div class="min-w-0 flex-1">
    <h2 id="cookie-consent-title" class="cookie-consent__title text-sm font-semibold">{copy.title}</h2>
    <p id="cookie-consent-description" class="cookie-consent__description mt-0.5 text-xs leading-5">
      {copy.body}
    </p>
  </div>
  <div class="mt-3 grid shrink-0 grid-cols-2 gap-2 sm:mt-0">
    <button
      type="button"
      data-cookie-choice="denied"
      aria-pressed="false"
      class="site-outline-control cookie-consent__choice min-h-11 min-w-24 px-4"
    >
      {copy.reject}
    </button>
    <button
      type="button"
      data-cookie-choice="granted"
      aria-pressed="false"
      class="site-outline-control cookie-consent__choice min-h-11 min-w-24 px-4"
    >
      {copy.accept}
    </button>
  </div>
</aside>

<style>
  .cookie-consent {
    --cookie-border: var(--color-border-strong);
    --cookie-background: rgb(255 255 255 / 72%);
    --cookie-shadow: 0 14px 40px rgb(24 24 27 / 10%);
    --cookie-text: var(--color-text);
    --cookie-text-secondary: var(--color-text-secondary);
    --site-control-background: rgb(255 255 255 / 45%);

    border-color: var(--cookie-border);
    background: var(--cookie-background);
    box-shadow: var(--cookie-shadow);
    color: var(--cookie-text);
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition:
      opacity 220ms var(--ease-base),
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1),
      color 300ms var(--ease-base),
      background-color 300ms var(--ease-base),
      border-color 300ms var(--ease-base);
  }

  .cookie-consent[data-state="open"] {
    opacity: 1;
    transform: none;
  }

  .cookie-consent__description {
    color: var(--cookie-text-secondary);
  }

  .cookie-consent[data-theme="dark"] {
    --cookie-border: rgb(255 255 255 / 15%);
    --cookie-background: color-mix(in srgb, var(--color-primary-deep) 58%, transparent);
    --cookie-shadow: 0 14px 40px rgb(0 0 0 / 18%);
    --cookie-text: white;
    --cookie-text-secondary: rgb(255 255 255 / 76%);
    --site-control-border: rgb(255 255 255 / 24%);
    --site-control-background: rgb(255 255 255 / 8%);
    --site-control-color: white;
    --site-control-hover-border: rgb(255 255 255 / 55%);
    --site-control-hover-background: rgb(255 255 255 / 13%);
    --site-control-hover-color: white;
    --site-control-focus: white;
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-consent {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var storageKey = "skillnet:analytics-consent";
    var banner = document.querySelector("[data-cookie-consent]");
    var choices = document.querySelectorAll("[data-cookie-choice]");
    var closeTimer = null;

    if (!banner) return;

    function readChoice() {
      try {
        var value = localStorage.getItem(storageKey);
        return value === "granted" || value === "denied" ? value : null;
      } catch (error) {
        return null;
      }
    }

    function reflectChoice(choice) {
      choices.forEach(function (button) {
        button.setAttribute(
          "aria-pressed",
          button.getAttribute("data-cookie-choice") === choice ? "true" : "false",
        );
      });
    }

    function updateTheme() {
      if (banner.classList.contains("hidden")) return;

      var bannerBounds = banner.getBoundingClientRect();
      var sampleY = Math.max(
        0,
        Math.min(window.innerHeight - 1, bannerBounds.top + bannerBounds.height / 2),
      );
      var sections = Array.from(document.querySelectorAll("[data-nav-theme]"));
      var section = sections.find(function (candidate) {
        var bounds = candidate.getBoundingClientRect();
        return bounds.top <= sampleY && bounds.bottom > sampleY;
      });
      var theme = section && section.getAttribute("data-nav-theme");
      banner.setAttribute("data-theme", theme === "dark" ? "dark" : "light");
    }

    function showBanner(shouldFocus) {
      if (closeTimer) window.clearTimeout(closeTimer);
      reflectChoice(readChoice());
      banner.classList.remove("hidden");
      banner.classList.add("flex");
      updateTheme();
      window.requestAnimationFrame(function () {
        updateTheme();
        banner.setAttribute("data-state", "open");
        if (shouldFocus) banner.focus({ preventScroll: true });
      });
    }

    function hideBanner() {
      banner.setAttribute("data-state", "closed");
      closeTimer = window.setTimeout(function () {
        banner.classList.add("hidden");
        banner.classList.remove("flex");
      }, window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 220);
    }

    function saveChoice(choice) {
      try {
        localStorage.setItem(storageKey, choice);
      } catch (error) {}

      if (choice === "granted" && typeof window.skillnetLoadAnalytics === "function") {
        window.skillnetLoadAnalytics();
      }

      if (typeof window.gtag === "function") {
        window.gtag("consent", "update", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: choice,
        });
      }

      reflectChoice(choice);
      hideBanner();
    }

    choices.forEach(function (button) {
      button.addEventListener("click", function () {
        saveChoice(button.getAttribute("data-cookie-choice"));
      });
    });

    window.addEventListener("skillnet:open-cookie-settings", function () {
      showBanner(true);
    });
    window.addEventListener("scroll", updateTheme, { passive: true });
    window.addEventListener("resize", updateTheme, { passive: true });

    if (!readChoice()) showBanner(false);
  })();
</script>
