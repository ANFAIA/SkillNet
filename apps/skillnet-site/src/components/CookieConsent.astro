---
import type { Locale } from "../i18n/config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy =
  lang === "en"
    ? {
        title: "Analytics cookies",
        body: "We use Google Analytics only if you accept. It helps us improve the site.",
        reject: "Reject",
        accept: "Accept",
        settings: "Cookie settings",
      }
    : {
        title: "Cookies analíticas",
        body: "Solo usamos Google Analytics si aceptas. Nos ayuda a mejorar la web.",
        reject: "Rechazar",
        accept: "Aceptar",
        settings: "Configurar cookies",
      };
---

<aside
  data-cookie-consent
  class="fixed inset-x-3 bottom-3 z-[100] mx-auto hidden max-w-md border border-border bg-bg p-4 shadow-[0_8px_24px_rgba(24,24,27,0.1)] sm:inset-x-auto sm:right-4 sm:bottom-4 sm:mx-0 sm:w-[26rem]"
  role="dialog"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-description"
>
  <div>
    <h2 id="cookie-consent-title" class="text-sm font-semibold text-text">{copy.title}</h2>
    <p id="cookie-consent-description" class="mt-1 text-xs leading-5 text-text-secondary">
      {copy.body}
    </p>
  </div>
  <div class="mt-3 grid grid-cols-2 gap-2">
    <button
      type="button"
      data-cookie-choice="denied"
      class="min-h-9 border border-border-strong bg-bg px-3 text-xs font-medium text-text transition-colors hover:border-primary hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      {copy.reject}
    </button>
    <button
      type="button"
      data-cookie-choice="granted"
      class="min-h-9 border border-primary bg-primary px-3 text-xs font-medium text-white transition-colors hover:bg-primary-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      {copy.accept}
    </button>
  </div>
</aside>

<button
  type="button"
  data-cookie-settings
  class="fixed bottom-4 left-4 z-[90] hidden border border-border-strong bg-bg px-3 py-2 text-xs font-medium text-text-secondary shadow-sm transition-colors hover:border-primary hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
>
  {copy.settings}
</button>

<script is:inline>
  (function () {
    var storageKey = "skillnet:analytics-consent";
    var banner = document.querySelector("[data-cookie-consent]");
    var settings = document.querySelector("[data-cookie-settings]");
    var choices = document.querySelectorAll("[data-cookie-choice]");

    if (!banner || !settings) return;

    function readChoice() {
      try {
        var value = localStorage.getItem(storageKey);
        return value === "granted" || value === "denied" ? value : null;
      } catch (error) {
        return null;
      }
    }

    function showBanner() {
      banner.classList.remove("hidden");
      settings.classList.add("hidden");
    }

    function showSettings() {
      banner.classList.add("hidden");
      settings.classList.remove("hidden");
    }

    function saveChoice(choice) {
      if (typeof window.gtag === "function") {
        window.gtag("consent", "update", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: choice,
        });
      }

      try {
        localStorage.setItem(storageKey, choice);
      } catch (error) {}

      showSettings();
    }

    choices.forEach(function (button) {
      button.addEventListener("click", function () {
        saveChoice(button.getAttribute("data-cookie-choice"));
      });
    });

    settings.addEventListener("click", showBanner);

    if (readChoice()) showSettings();
    else showBanner();
  })();
</script>
