---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { splitDocId } from "../../content.config";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries
    .map((entry) => ({ entry, ...splitDocId(entry.id) }))
    .filter((e) => e.locale === "es")
    .map(({ entry, slug }) => ({
      params: { slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { slug } = splitDocId(entry.id);

const allEntries = (await getCollection("docs"))
  .map((e) => ({ ...splitDocId(e.id), title: e.data.title, order: e.data.order, section: e.data.section, group: e.data.group }))
  .filter((e) => e.locale === "es")
  .sort((a, b) => a.order - b.order);

// The equivalent English page shares the same slug under en/, if it exists.
const hasEnVersion = (await getCollection("docs")).some(
  (e) => splitDocId(e.id).locale === "en" && splitDocId(e.id).slug === slug,
);
---

<DocsLayout
  title={entry.data.title}
  description={`Documentación de SkillNet — ${entry.data.title}.`}
  navEntries={allEntries}
  currentSlug={slug}
  locale="es"
  altSlug={hasEnVersion ? slug : undefined}
>
  <Content />
</DocsLayout>
