---
import SiteLayout from '../../layouts/SiteLayout.astro'
import { siteData } from '../../lib/site'

const labels: Record<string, string> = {
  present: 'Present',
  'not-migrated': 'Not migrated',
  inventoried: 'Inventoried',
  'not-started': 'Not started',
}
---

<SiteLayout
  title="SkillNet docs — Migration status"
  description="The future home of SkillNet documentation, with an explicit allowlist and a visible migration status."
  canonicalPath="/docs/"
>
  <section class="hero hero-narrow shell">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><span>Docs</span>
    </nav>
    <p class="eyebrow">Documentation</p>
    <h1>Docs are moving here, carefully.</h1>
    <p class="hero-copy">
      The public site and technical documentation will share one domain. The migration has not
      started: no repository document is exposed by this provisional artifact.
    </p>
  </section>

  <section class="section shell" aria-labelledby="status-heading">
    <div class="section-heading">
      <p class="kicker">Migration status</p>
      <h2 id="status-heading">Visible progress, no accidental publishing.</h2>
    </div>
    <div class="status-table" role="list">
      {siteData.docsMigration.map((item) => (
        <article class="status-row" role="listitem">
          <div>
            <h3>{item.area}</h3>
            <p>{item.note}</p>
          </div>
          <span class:list={['migration-tag', `status-${item.status}`]}>{labels[item.status]}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="section evidence-band" aria-labelledby="contract-heading">
    <div class="shell split">
      <div>
        <p class="kicker">Publication contract</p>
        <h2 id="contract-heading">Allowlist first.</h2>
      </div>
      <div class="prose-stack">
        <p>
          A file under <code>repo/docs/</code> does not become public because it exists. Each page
          needs an explicit manifest entry, owner, status, review date and canonical route.
        </p>
        <p>
          Missing sources, paths outside the approved documentation roots and entries without
          public status must fail validation before a build is accepted.
        </p>
      </div>
    </div>
  </section>

  <section class="section shell boundary" aria-labelledby="next-docs-heading">
    <div class="section-heading compact">
      <p class="kicker">Next increment</p>
      <h2 id="next-docs-heading">What unlocks the first document</h2>
    </div>
    <ol class="boundary-list numbered">
      <li>Approve one source document for public use.</li>
      <li>Review its claims, links, assets and language.</li>
      <li>Add it to the manifest and validate its canonical route.</li>
      <li>Migrate any visualisation only when it helps that approved page.</li>
    </ol>
  </section>
</SiteLayout>
