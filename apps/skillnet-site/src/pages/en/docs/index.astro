---
import { getCollection } from "astro:content";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import { splitDocId } from "../../../content.config";
import { buildDocsTree } from "../../../data/docsNav";

const entries = (await getCollection("docs"))
  .map((e) => ({ ...splitDocId(e.id), title: e.data.title, order: e.data.order, section: e.data.section, group: e.data.group }))
  .filter((e) => e.locale === "en")
  .sort((a, b) => a.order - b.order);

const groups = buildDocsTree(entries, "en");
---

<DocsLayout
  title="Documentation"
  description="SkillNet technical documentation: architecture, API, content generation, RAG, and the design of dynamic courses."
  navEntries={entries}
  locale="en"
>
  <h1>Documentation</h1>
  <p class="type-lead">
    Quickstart, system architecture, and the design of each piece — content generation, RAG,
    chat with agents, dynamic courses, and personalization. This documentation closely follows
    <code>docs/design/</code> in the repository.
  </p>

  {groups.map((group) => (
    <section class="docs-index__group">
      <h2>{group.label}</h2>
      <ul class="docs-index__list">
        {group.nodes.map((node) => (
          <li>
            <a href={`/en/docs/${node.entry.slug}`}>{node.entry.title}</a>
            {node.children.length > 0 && (
              <ul class="docs-index__list docs-index__list--nested">
                {node.children.map((child) => (
                  <li><a href={`/en/docs/${child.slug}`}>{child.title}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</DocsLayout>

<style>
  .docs-index__group {
    margin-bottom: 8px;
  }

  .docs-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .docs-index__list a {
    display: block;
    padding: 4px 0;
    font-size: 1.02rem;
    overflow-wrap: anywhere;
  }

  .docs-index__list--nested {
    margin-left: 14px;
    border-left: 1px solid var(--color-border);
    padding-left: 12px;
  }
</style>
