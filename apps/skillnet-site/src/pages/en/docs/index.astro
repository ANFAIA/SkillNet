---
import { getCollection } from "astro:content";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import { splitDocId } from "../../../content.config";
import { SECTION_LABELS, SECTION_ORDER } from "../../../data/docsNav";

const entries = (await getCollection("docs"))
  .map((e) => ({ ...splitDocId(e.id), title: e.data.title, order: e.data.order, section: e.data.section }))
  .filter((e) => e.locale === "en")
  .sort((a, b) => a.order - b.order);

const labels = SECTION_LABELS.en;

const groups = SECTION_ORDER.map((section) => ({
  section,
  label: labels[section],
  items: entries.filter((e) => e.section === section),
})).filter((g) => g.items.length > 0);
---

<DocsLayout
  title="Documentation"
  description="SkillNet technical documentation: architecture, API, content generation, RAG, and the design of dynamic courses."
  navEntries={entries}
  locale="en"
>
  <h1>Documentation</h1>
  <p class="type-lead">
    Quickstart, system architecture, and the design of each piece — content generation, RAG,
    chat with agents, dynamic courses, and personalization. This documentation closely follows
    <code>docs/design/</code> in the repository.
  </p>

  {groups.map((group) => (
    <section class="docs-index__group">
      <h2>{group.label}</h2>
      <ul class="docs-index__list">
        {group.items.map((item) => (
          <li>
            <a href={`/en/docs/${item.slug}`}>{item.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</DocsLayout>

<style>
  .docs-index__group {
    margin-bottom: 8px;
  }

  .docs-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .docs-index__list a {
    display: block;
    padding: 4px 0;
    font-size: 1.02rem;
  }
</style>
