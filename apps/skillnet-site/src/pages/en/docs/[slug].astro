---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import { splitDocId } from "../../../content.config";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries
    .map((entry) => ({ entry, ...splitDocId(entry.id) }))
    .filter((e) => e.locale === "en")
    .map(({ entry, slug }) => ({
      params: { slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { slug } = splitDocId(entry.id);
const pageHeadings = headings
  .filter((heading) => heading.depth === 2)
  .map(({ slug: headingSlug, text }) => ({ slug: headingSlug, text }));

const allEntries = (await getCollection("docs"))
  .map((e) => ({ ...splitDocId(e.id), title: e.data.title, order: e.data.order, section: e.data.section, group: e.data.group }))
  .filter((e) => e.locale === "en")
  .sort((a, b) => a.order - b.order);

// The equivalent Spanish page shares the same slug under es/, if it exists.
const hasEsVersion = (await getCollection("docs")).some(
  (e) => splitDocId(e.id).locale === "es" && splitDocId(e.id).slug === slug,
);
---

<DocsLayout
  title={entry.data.title}
  description={`SkillNet documentation — ${entry.data.title}.`}
  navEntries={allEntries}
  currentSlug={slug}
  locale="en"
  altSlug={hasEsVersion ? slug : undefined}
  headings={pageHeadings}
>
  <Content />
</DocsLayout>
