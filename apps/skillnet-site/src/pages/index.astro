---
import ClaimPanel from '../components/ClaimPanel.astro'
import Workflow from '../components/Workflow.astro'
import SiteLayout from '../layouts/SiteLayout.astro'
import { getClaim, siteData } from '../lib/site'

const documentClaim = getClaim('claim-documents-to-courses')
const workflowClaim = getClaim('claim-company-workflow')
const hostingClaim = getClaim('claim-open-self-hosted')

const steps = [
  {
    number: '01',
    title: 'Start with company knowledge',
    body: 'Use the documents, procedures and manuals the organisation already maintains.',
  },
  {
    number: '02',
    title: 'Prepare reviewable training',
    body: 'Turn that material into structured learning content inside an admin workflow.',
  },
  {
    number: '03',
    title: 'Learn and follow progress',
    body: 'Employees work through assigned material while admins keep a view of the learning record.',
  },
]
---

<SiteLayout
  title="SkillNet — Training grounded in company knowledge"
  description="SkillNet is open-source, self-hosted training software that turns company documents into courses employees can work through."
  canonicalPath="/"
>
  <section class="hero shell">
    <p class="eyebrow">Open-source training software</p>
    <h1>Turn company knowledge into training people can work through.</h1>
    <p class="hero-copy">
      SkillNet is a company-first product for building learning content from internal material,
      reviewing it and making it available to employees.
    </p>
    <div class="action-row">
      <a class="button button-primary" href="/for/companies/">Explore the company workflow</a>
      <a
        class="button button-secondary"
        href={siteData.primaryCta.href}
        rel="noreferrer"
        target="_blank"
      >
        {siteData.primaryCta.label}<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </section>

  <section class="section shell" aria-labelledby="how-heading">
    <div class="section-heading">
      <p class="kicker">The common path</p>
      <h2 id="how-heading">Documents in. Reviewed learning out.</h2>
      <p>A restrained description of the current company workflow—without outcome promises.</p>
    </div>
    <Workflow steps={steps} />
  </section>

  <section class="section evidence-band" aria-labelledby="scope-heading">
    <div class="shell">
      <div class="section-heading">
        <p class="kicker">Verified scope</p>
        <h2 id="scope-heading">What the repository supports us saying.</h2>
      </div>
      <div class="claim-grid">
        <ClaimPanel claim={documentClaim} />
        <ClaimPanel claim={workflowClaim} />
        <ClaimPanel claim={hostingClaim} />
      </div>
    </div>
  </section>

  <section class="section shell split" aria-labelledby="one-product-heading">
    <div>
      <p class="kicker">One product</p>
      <h2 id="one-product-heading">One honest starting point.</h2>
    </div>
    <div>
      <p>
        The first vertical is for companies because that is the implemented product baseline.
        Education, training-provider and individual pages stay unpublished until each has its own
        reviewed workflow and evidence.
      </p>
      <a class="text-link" href="/for/companies/">Read the company use case <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section shell boundary" aria-labelledby="not-claimed-heading">
    <div class="section-heading compact">
      <p class="kicker">Clear boundary</p>
      <h2 id="not-claimed-heading">Not claimed in this cut</h2>
    </div>
    <ul class="boundary-list">
      <li>measured learning outcomes or customer results;</li>
      <li>a hosted SkillNet service or instant sign-up;</li>
      <li>individual mode as an available product;</li>
      <li>automatic adaptive regeneration as a current capability;</li>
      <li>a public live demo.</li>
    </ul>
  </section>
</SiteLayout>
