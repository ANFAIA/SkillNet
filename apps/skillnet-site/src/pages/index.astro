---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.tsx";
import SiteHeader from "../components/SiteHeader.tsx";
import WhatWeDoSection from "../components/WhatWeDoSection.tsx";
import ProblemSection from "../components/ProblemSection.tsx";
import HowItWorksSection from "../components/HowItWorksSection.tsx";
import StableAdaptSection from "../components/StableAdaptSection.tsx";
import CollaborationSection from "../components/CollaborationSection.tsx";
import ProfilesSection from "../components/ProfilesSection.tsx";
import FutureSection from "../components/FutureSection.tsx";
import SiteFooter from "../components/SiteFooter.tsx";
---

<BaseLayout
  title="SkillNet"
  description="SkillNet es una plataforma de aprendizaje abierta y colaborativa: la misma fuente de conocimiento, una experiencia distinta para cada persona."
>
  <Hero client:load />
  <main class="relative z-10 bg-white">
    <WhatWeDoSection client:load />
    <ProblemSection client:load />
    <HowItWorksSection client:load />
    <ProfilesSection client:load />
    <CollaborationSection client:load />
    <FutureSection client:load />
    <StableAdaptSection client:load />
    <SiteFooter client:load />
  </main>
  <SiteHeader client:load />
</BaseLayout>
