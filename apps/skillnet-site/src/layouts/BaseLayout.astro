---
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: string;
}

const { title, description, lang = "es" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/brand/skillnet-logo.png?v=5" />
    <link rel="shortcut icon" type="image/png" href="/images/brand/skillnet-logo.png?v=5" />
    <link rel="apple-touch-icon" href="/images/brand/skillnet-logo.png?v=5" />
    <link
      rel="preload"
      as="image"
      href="/images/landing/skillnet-learning-commons-background-v1.webp"
      fetchpriority="high"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
