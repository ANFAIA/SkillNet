---
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";
import { LANG_STORAGE_KEY, type Locale } from "../i18n/config";

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  /**
   * Path of the equivalent page in the other locale. Omitted when this page has
   * no counterpart, which both suppresses the hreflang pair and stops the
   * detector from redirecting into a URL that does not exist.
   */
  altHref?: string;
}

const { title, description, lang = "es", altHref } = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const altUrl = altHref ? new URL(altHref, site).toString() : null;
const esUrl = lang === "es" ? canonicalUrl : altUrl;
const enUrl = lang === "en" ? canonicalUrl : altUrl;
const googleTagManagerId = "GTM-MSFGKTR4";
const analyticsConsentStorageKey = "skillnet:analytics-consent";

const googleConsentScript = `(function(w){
w.dataLayer=w.dataLayer||[];
w.gtag=w.gtag||function(){w.dataLayer.push(arguments);};
var saved=null;try{saved=localStorage.getItem(${JSON.stringify(analyticsConsentStorageKey)});}catch(e){}
var analytics=saved==="granted"?"granted":"denied";
var defaults={
ad_storage:"denied",
ad_user_data:"denied",
ad_personalization:"denied",
analytics_storage:analytics
};
if(saved!=="granted"&&saved!=="denied")defaults.wait_for_update=500;
w.gtag("consent","default",defaults);
w.gtag("set","ads_data_redaction",true);
})(window);`;

const googleTagManagerScript = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer',${JSON.stringify(googleTagManagerId)});`;

/**
 * Language detection, inline and render-blocking.
 *
 * The site is built by `astro build` and served by nginx as flat files, so
 * there is no server to negotiate on `Accept-Language`: the redirect has to
 * happen in the browser. Running it here, in <head>, means it fires before the
 * body is parsed and painted, so a redirected visitor never sees the wrong
 * language flash. Inline (not a module, not deferred) for the same reason.
 *
 * The rules are asymmetric on purpose, which is what makes a loop impossible:
 *  - an explicit stored choice always wins, in both directions;
 *  - with no stored choice, only the Spanish (default-locale) page auto-sends
 *    an English browser to /en/. The /en/ page never auto-sends anyone back,
 *    so a shared /en/ link keeps working for a Spanish-speaking reader.
 * Every redirect therefore lands on a page whose own rules resolve to "stay".
 */
const detectScript = `(function(){try{
var cur=${JSON.stringify(lang)},alt=${JSON.stringify(altHref ?? null)};
if(!alt)return;
var stored=null;try{stored=localStorage.getItem(${JSON.stringify(LANG_STORAGE_KEY)});}catch(e){}
if(stored!=="es"&&stored!=="en")stored=null;
var want=stored?stored:(cur==="es"&&/^en\\b/i.test(navigator.language||"")?"en":cur);
if(want!==cur)location.replace(alt+location.hash);
}catch(e){}})();`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- Consent Mode defaults must run before Google Tag Manager. -->
    <script is:inline set:html={googleConsentScript} />
    <!-- Google Tag Manager -->
    <script is:inline set:html={googleTagManagerScript} />
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={detectScript} />
    <link rel="icon" type="image/svg+xml" href="/images/brand/skillnet-favicon.svg?v=7" />
    <link rel="shortcut icon" type="image/svg+xml" href="/images/brand/skillnet-favicon.svg?v=7" />
    <link rel="apple-touch-icon" href="/images/brand/skillnet-logo.png?v=5" />
    <link
      rel="preload"
      as="image"
      href="/images/landing/skillnet-learning-commons-background-v1.webp"
      fetchpriority="high"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {/* What makes Google and the LinkedIn preview serve the right language. */}
    {esUrl && <link rel="alternate" hreflang="es" href={esUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {esUrl && <link rel="alternate" hreflang="x-default" href={esUrl} />}
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_ES"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${googleTagManagerId}`}
        height="0"
        width="0"
        title="Google Tag Manager"
        hidden
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
    <CookieConsent lang={lang} />
  </body>
</html>
