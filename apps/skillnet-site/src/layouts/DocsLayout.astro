---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.tsx";
import SiteFooter from "../components/SiteFooter.tsx";
import DocsSidebar from "../components/docs/DocsSidebar.astro";

interface NavEntry {
  slug: string;
  title: string;
  section: string;
}

interface Props {
  title: string;
  description: string;
  navEntries: NavEntry[];
  currentSlug?: string;
  locale: "es" | "en";
  /** Slug of the equivalent page in the other locale, if it exists. */
  altSlug?: string;
}

const { title, description, navEntries, currentSlug, locale, altSlug } = Astro.props;

const isEn = locale === "en";
const siteTitle = isEn ? "SkillNet Documentation" : "Documentación SkillNet";
const otherLocale = isEn ? "es" : "en";
const otherBasePath = isEn ? "/docs" : "/en/docs";
const thisBasePath = isEn ? "/en/docs" : "/docs";
const otherHref = altSlug ? `${otherBasePath}/${altSlug}` : otherBasePath;
const canonicalPath = currentSlug ? `${thisBasePath}/${currentSlug}` : thisBasePath;

const navSummary = isEn ? "Browse the documentation" : "Explorar la documentación";
const navHere = isEn ? "On this page" : "Estás en";

const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(canonicalPath, site).toString();
const otherUrl = new URL(otherHref, site).toString();
---

<BaseLayout title={`${title} · ${siteTitle}`} description={description} lang={locale}>
  <Fragment slot="head">
    <link rel="alternate" hreflang="es" href={isEn ? otherUrl : canonicalUrl} />
    <link rel="alternate" hreflang="en" href={isEn ? canonicalUrl : otherUrl} />
    <link rel="alternate" hreflang="x-default" href={isEn ? otherUrl : canonicalUrl} />
  </Fragment>
  <SiteHeader client:load variant="docs" locale={locale} altHref={otherHref} />
  <div class="docs-shell">
    <aside class="docs-shell__sidebar">
      <input class="docs-nav__toggle" type="checkbox" id="docs-nav-toggle" />
      <label class="docs-nav__control" for="docs-nav-toggle">
        <svg class="docs-nav__caret" width="11" height="11" viewBox="0 0 10 10" aria-hidden="true">
          <path d="M3 1.5 L7 5 L3 8.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="docs-nav__text type-ui">{navSummary}</span>
        {currentSlug && <span class="docs-nav__here type-ui">{navHere}: {title}</span>}
      </label>
      <div class="docs-nav__panel">
        <DocsSidebar entries={navEntries} currentSlug={currentSlug} locale={locale} />
      </div>
    </aside>
    <main class="docs-shell__content">
      <article class="prose-docs">
        <slot />
      </article>
    </main>
  </div>
  <SiteFooter client:load />
</BaseLayout>

<style>
  .docs-shell {
    /* Smaller, denser type scale for the docs section than the marketing
       pages — matches the previous standalone docs site (15px body,
       ~13px code). These override the global --type-* tokens only within
       this subtree (sidebar links and prose both read them). */
    --type-section: 1.6rem;
    --type-body: 0.9375rem;
    --type-ui: 0.75rem;

    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 48px;
    max-width: 1120px;
    margin: 0 auto;
    padding: 128px 32px 96px;
  }

  .docs-shell__sidebar {
    position: sticky;
    top: 112px;
    align-self: start;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
  }

  .docs-shell__content {
    min-width: 0;
  }

  .prose-docs {
    max-width: 720px;
    color: var(--color-text);
    font-size: var(--type-body);
    line-height: 1.7;
  }

  .prose-docs :global(h1),
  .prose-docs :global(h2),
  .prose-docs :global(h3) {
    overflow-wrap: break-word;
  }

  .prose-docs :global(h1) {
    font-size: var(--type-section);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.028em;
    margin: 0 0 20px;
  }

  .prose-docs :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    margin: 40px 0 16px;
    padding-top: 8px;
    border-top: 1px solid var(--color-border);
  }

  .prose-docs :global(h2:first-child) {
    border-top: none;
    padding-top: 0;
  }

  .prose-docs :global(h3) {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 28px 0 12px;
  }

  .prose-docs :global(p) {
    margin: 0 0 16px;
    color: var(--color-text);
  }

  .prose-docs :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose-docs :global(a:hover) {
    color: var(--color-primary-deep);
  }

  .prose-docs :global(ul),
  .prose-docs :global(ol) {
    margin: 0 0 16px;
    padding-left: 1.4em;
  }

  .prose-docs :global(li) {
    margin: 6px 0;
  }

  .prose-docs :global(blockquote) {
    margin: 0 0 20px;
    border-left: 3px solid var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 5%, transparent);
    padding: 4px 16px;
    color: var(--color-text-secondary);
    border-radius: 0 8px 8px 0;
  }

  .prose-docs :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* Long identifiers ("learner_node_states.pinned_at") have no natural break
     opportunity, so an inline code span used to push the whole document to
     416px inside a 375px viewport. */
  .prose-docs :global(code) {
    overflow-wrap: anywhere;
    background: color-mix(in srgb, var(--color-text) 6%, var(--color-bg));
    border-radius: 4px;
    padding: 0.15em 0.4em;
    font-size: 0.86em;
    font-family: "SF Mono", "Fira Code", ui-monospace, monospace;
  }

  .prose-docs :global(img),
  .prose-docs :global(svg),
  .prose-docs :global(iframe) {
    max-width: 100%;
    height: auto;
  }

  .prose-docs :global(pre) {
    margin: 0 0 20px;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-text) 4%, var(--color-bg));
    padding: 16px;
  }

  .prose-docs :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.85em;
    line-height: 1.6;
  }

  /* Markdown tables arrive as a bare <table> directly inside the article, which
     has no horizontal overflow of its own — a wide one pushed the whole document
     to 671px inside a 375px viewport. Making the table itself the scroll
     container keeps the overflow in the table: `display: block` moves the
     scrollbox to the table box while the rows keep their table layout, and
     `width: max-content` lets columns size to their content rather than being
     squeezed into a width the phone does not have. */
  .prose-docs :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    margin: 0 0 20px;
    border-collapse: collapse;
    font-size: 0.88em;
  }

  .prose-docs :global(.table-wrap) {
    overflow-x: auto;
    margin: 0 0 20px;
  }

  .prose-docs :global(th),
  .prose-docs :global(td) {
    border: 1px solid var(--color-border);
    padding: 8px 12px;
    text-align: left;
    vertical-align: top;
  }

  .prose-docs :global(th) {
    background: color-mix(in srgb, var(--color-text) 4%, var(--color-bg));
    font-weight: 600;
  }

  .prose-docs :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 32px 0;
  }

  /* The sidebar collapses with a checkbox rather than <details> on purpose. A
     closed <details> lays its content out without contributing height, which
     collapsed the desktop sidebar column to 0px, and making it open on desktop
     needed JavaScript that could race the first paint. A checkbox lets CSS alone
     decide: above the breakpoint the control is hidden and the panel always
     shows, below it the panel follows :checked. No script, nothing to race. */
  .docs-nav__toggle,
  .docs-nav__control {
    display: none;
  }

  @media (max-width: 999px) {
    .docs-shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding: 104px 16px 56px;
    }

    .docs-shell__sidebar {
      position: static;
      max-height: none;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 24px;
      margin-bottom: 8px;
    }

    .prose-docs {
      max-width: none;
    }

    /* The 64-link list used to sit above the article and push it to y=2841 on a
       375px screen. Collapsed by default, the article now starts right below a
       single row. */
    .docs-nav__control {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: color-mix(in srgb, var(--color-text) 3%, var(--color-bg));
      padding: 11px 14px;
      min-height: 44px;
      color: var(--color-text);
      cursor: pointer;
      list-style: none;
    }

    .docs-nav__text {
      font-weight: 600;
    }

    .docs-nav__here {
      flex-basis: 100%;
      min-width: 0;
      color: var(--color-text-secondary);
      overflow-wrap: anywhere;
    }

    .docs-nav__caret {
      flex-shrink: 0;
      color: var(--color-text-secondary);
      transition: transform 0.18s var(--ease-base);
    }

    .docs-nav__toggle:checked ~ .docs-nav__control .docs-nav__caret {
      transform: rotate(90deg);
    }

    /* Collapsed, the sidebar contributes only its control row. */
    .docs-nav__panel {
      display: none;
      padding-top: 8px;
    }

    .docs-nav__toggle:checked ~ .docs-nav__panel {
      display: block;
    }

    /* The checkbox stays in the accessibility tree and keyboard-focusable; it is
       only visually removed, so the label keeps working as the control. */
    .docs-nav__toggle {
      display: block;
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      margin: 0;
      pointer-events: none;
    }

    .docs-nav__toggle:focus-visible ~ .docs-nav__control {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }
  }

  @media (max-width: 999px) and (prefers-reduced-motion: reduce) {
    .docs-nav__caret {
      transition: none;
    }
  }
</style>
