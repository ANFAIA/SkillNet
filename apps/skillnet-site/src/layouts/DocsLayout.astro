---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.tsx";
import SiteFooter from "../components/SiteFooter.tsx";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import DocsPageToc, { type DocsPageHeading } from "../components/docs/DocsPageToc.tsx";
import { buildDocsFileTree } from "../data/docsNav";
import { ClientRouter } from "astro:transitions";

interface NavEntry {
  slug: string;
  title: string;
  section: string;
  order: number;
  group?: string;
}

interface Props {
  title: string;
  description: string;
  navEntries: NavEntry[];
  currentSlug?: string;
  locale: "es" | "en";
  /** Slug of the equivalent page in the other locale, if it exists. */
  altSlug?: string;
  headings?: DocsPageHeading[];
}

const { title, description, navEntries, currentSlug, locale, altSlug, headings = [] } = Astro.props;

const isEn = locale === "en";
const siteTitle = isEn ? "SkillNet Documentation" : "Documentación SkillNet";
const otherLocale = isEn ? "es" : "en";
const otherBasePath = isEn ? "/docs" : "/en/docs";
const otherHref = altSlug ? `${otherBasePath}/${altSlug}` : otherBasePath;

const docsBasePath = isEn ? "/en/docs" : "/docs";
const { nodes: docsNodes, openIds: docsOpenIds } = buildDocsFileTree(
  navEntries,
  locale,
  currentSlug,
  docsBasePath,
);
---

<BaseLayout title={`${title} · ${siteTitle}`} description={description} lang={locale} altHref={otherHref}>
  {/* Docs pages navigate with view transitions so the sidebar below can survive
      the swap (transition:persist). Without it every click is a full document
      load: the island remounts, the tree re-collapses to whatever section the
      new page sits in, and any section the reader had opened is gone. Measured:
      the tree jumped from 841px to 232px on a single click. The router lives
      here and not in BaseLayout on purpose — only the docs section needs it, and
      the marketing pages keep their plain full-page loads. */}
  <ClientRouter slot="head" />
  <SiteHeader
    client:load
    variant="docs"
    locale={locale}
    altHref={otherHref}
    docsNodes={docsNodes}
    docsOpenIds={docsOpenIds}
    currentDocSlug={currentSlug}
  />
  {/* The docs document declares its own background the same way every landing
      section does, so the shared header reads what is behind it here too and
      paints the light glass instead of the hero's dark pill. */}
  <div class="docs-shell" data-nav-theme="light">
    <aside class="docs-shell__sidebar">
      {/* The desktop panel persists across page swaps so its expanded sections
          and scroll position survive navigation. Mobile renders the same tree
          inside SiteHeader instead. */}
      <div class="docs-nav__panel" transition:persist="docs-nav-panel">
        <DocsSidebar entries={navEntries} currentSlug={currentSlug} locale={locale} />
      </div>
    </aside>
    {headings.length > 0 && (
      <div class="docs-shell__toc">
        <DocsPageToc client:load headings={headings} locale={locale} />
      </div>
    )}
    <main class="docs-shell__content">
      <article class="prose-docs">
        <slot />
      </article>
    </main>
  </div>
  <SiteFooter client:load lang={locale} />
</BaseLayout>

<style>
  .docs-shell {
    /* Smaller, denser type scale for the docs section than the marketing
       pages — matches the previous standalone docs site (15px body,
       ~13px code). These override the global --type-* tokens only within
       this subtree (sidebar links and prose both read them). */
    --type-section: 1.6rem;
    --type-body: 0.9375rem;
    --type-ui: 0.75rem;

    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 190px;
    gap: clamp(24px, 2vw, 32px);
    width: 80%;
    max-width: none;
    margin: 0 auto;
    padding: 128px 0 96px;
  }

  .docs-shell__sidebar {
    position: sticky;
    grid-column: 1;
    grid-row: 1;
    top: 96px;
    align-self: start;
    max-height: calc(100dvh - 120px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .docs-shell__content {
    display: flex;
    grid-column: 2;
    grid-row: 1;
    justify-content: center;
    min-width: 0;
  }

  .docs-shell__toc {
    grid-column: 3;
    grid-row: 1;
    min-width: 0;
  }

  .prose-docs {
    width: 100%;
    max-width: 760px;
    color: var(--color-text);
    font-size: var(--type-body);
    line-height: 1.7;
  }

  .prose-docs :global(h1),
  .prose-docs :global(h2),
  .prose-docs :global(h3) {
    overflow-wrap: break-word;
    scroll-margin-top: 112px;
  }

  .prose-docs :global(h1) {
    font-size: var(--type-section);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.028em;
    margin: 0 0 20px;
  }

  .prose-docs :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    margin: 40px 0 16px;
    padding-top: 8px;
    border-top: 1px solid var(--color-border);
  }

  .prose-docs :global(h2:first-child) {
    border-top: none;
    padding-top: 0;
  }

  .prose-docs :global(h3) {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 28px 0 12px;
  }

  .prose-docs :global(p) {
    margin: 0 0 16px;
    color: var(--color-text);
  }

  .prose-docs :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose-docs :global(a:hover) {
    color: var(--color-primary-deep);
  }

  .prose-docs :global(ul),
  .prose-docs :global(ol) {
    margin: 0 0 16px;
    padding-left: 1.4em;
  }

  .prose-docs :global(li) {
    margin: 6px 0;
  }

  .prose-docs :global(blockquote) {
    margin: 0 0 20px;
    border-left: 3px solid var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 5%, transparent);
    padding: 4px 16px;
    color: var(--color-text-secondary);
    border-radius: 0 8px 8px 0;
  }

  .prose-docs :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* Long identifiers ("learner_node_states.pinned_at") have no natural break
     opportunity, so an inline code span used to push the whole document to
     416px inside a 375px viewport. */
  .prose-docs :global(code) {
    overflow-wrap: anywhere;
    background: color-mix(in srgb, var(--color-text) 6%, var(--color-bg));
    border-radius: 4px;
    padding: 0.15em 0.4em;
    font-size: 0.86em;
    font-family: "SF Mono", "Fira Code", ui-monospace, monospace;
  }

  .prose-docs :global(img),
  .prose-docs :global(svg),
  .prose-docs :global(iframe) {
    max-width: 100%;
    height: auto;
  }

  .prose-docs :global(pre) {
    margin: 0 0 20px;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-text) 4%, var(--color-bg));
    padding: 16px;
  }

  .prose-docs :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.85em;
    line-height: 1.6;
  }

  /* Markdown tables arrive as a bare <table> directly inside the article, which
     has no horizontal overflow of its own — a wide one pushed the whole document
     to 671px inside a 375px viewport. Making the table itself the scroll
     container keeps the overflow in the table: `display: block` moves the
     scrollbox to the table box while the rows keep their table layout, and
     `width: max-content` lets columns size to their content rather than being
     squeezed into a width the phone does not have. */
  .prose-docs :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    margin: 0 0 20px;
    border-collapse: collapse;
    font-size: 0.88em;
  }

  .prose-docs :global(.table-wrap) {
    overflow-x: auto;
    margin: 0 0 20px;
  }

  .prose-docs :global(th),
  .prose-docs :global(td) {
    border: 1px solid var(--color-border);
    padding: 8px 12px;
    text-align: left;
    vertical-align: top;
  }

  .prose-docs :global(th) {
    background: color-mix(in srgb, var(--color-text) 4%, var(--color-bg));
    font-weight: 600;
  }

  .prose-docs :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 32px 0;
  }

  :global(.docs-page-toc--desktop) {
    position: sticky;
    top: 96px;
    max-height: calc(100dvh - 120px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  :global(.docs-page-toc__title) {
    margin: 0 0 12px;
    color: var(--color-text);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
  }

  :global(.docs-page-toc__list) {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
  }

  :global(.docs-page-toc__link) {
    display: block;
    padding: 5px 0;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    line-height: 1.45;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.15s var(--ease-base);
  }

  :global(.docs-page-toc__link:hover) {
    color: var(--color-text);
  }

  :global(.docs-page-toc__link[aria-current="location"]) {
    color: var(--color-primary-deep);
    font-weight: 600;
  }

  :global(.docs-page-toc__link:focus-visible),
  :global(.docs-page-toc__summary:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  :global(.docs-page-toc--mobile) {
    display: none;
  }

  @media (max-width: 1199px) {
    .docs-shell {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 40px;
    }

    .docs-shell__toc {
      display: none;
    }
  }

  @media (max-width: 999px) {
    .docs-shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      width: auto;
      padding: 104px 16px 56px;
    }

    .docs-shell__sidebar {
      display: none;
    }

    .prose-docs {
      max-width: none;
    }

    .docs-shell__toc {
      display: block;
      grid-column: 1;
      grid-row: 1;
    }

    .docs-shell__content {
      grid-column: 1;
      grid-row: 2;
    }

    :global(.docs-page-toc--desktop) {
      display: none;
    }

    :global(.docs-page-toc--mobile) {
      display: block;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 20px;
    }

    :global(.docs-page-toc__summary) {
      display: flex;
      min-height: 44px;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 10px 12px;
      color: var(--color-text);
      font-size: 0.8125rem;
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }

    :global(.docs-page-toc__summary::-webkit-details-marker) {
      display: none;
    }

    :global(.docs-page-toc__summary small) {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      color: var(--color-text-secondary);
      font-size: 0.6875rem;
      font-weight: 400;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    :global(.docs-page-toc__chevron) {
      flex: none;
      color: var(--color-text-secondary);
      transition: transform 0.18s var(--ease-base);
    }

    :global(.docs-page-toc--mobile[open] .docs-page-toc__chevron) {
      transform: rotate(180deg);
    }

    :global(.docs-page-toc__list--mobile) {
      max-height: 44dvh;
      overflow-y: auto;
      margin-top: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.docs-page-toc__link),
    :global(.docs-page-toc__chevron) {
      transition: none;
    }
  }
</style>
