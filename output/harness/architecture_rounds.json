{
  "schema_version": 1,
  "rounds": {
    "R1": {
      "title": "Contrato neutral",
      "gates": [
        {"metric": "provider_leaks", "operator": "eq", "threshold": 0},
        {"metric": "resolved_bindings", "operator": "eq", "threshold": 1}
      ]
    },
    "R2": {
      "title": "Evidencia normalizada a mastery",
      "gates": [
        {"metric": "accepted_attempts", "operator": "eq", "threshold": 2},
        {"metric": "duplicate_updates", "operator": "eq", "threshold": 0},
        {"metric": "mastery", "operator": "eq", "threshold": 0.4}
      ]
    },
    "R3": {
      "title": "Registro de adaptadores y fallback",
      "gates": [
        {"metric": "known_resolved", "operator": "eq", "threshold": 1},
        {"metric": "fallback_resolved", "operator": "eq", "threshold": 1},
        {"metric": "unknown_safe", "operator": "eq", "threshold": 1},
        {"metric": "central_component_switches", "operator": "eq", "threshold": 0}
      ]
    },
    "R4": {
      "title": "Generacion multiagente en design-time",
      "gates": [
        {"metric": "specialists", "operator": "gte", "threshold": 4},
        {"metric": "coverage", "operator": "eq", "threshold": 1},
        {"metric": "parallel_speedup", "operator": "gte", "threshold": 2},
        {"metric": "runtime_authoring_calls", "operator": "eq", "threshold": 0}
      ]
    },
    "R5": {
      "title": "Ritmos flexibles y personalizacion",
      "gates": [
        {"metric": "unique_rhythms", "operator": "gte", "threshold": 4},
        {"metric": "maximum_step_repeat", "operator": "lte", "threshold": 2},
        {"metric": "brief_first_rate", "operator": "gte", "threshold": 0.75}
      ]
    },
    "R6": {
      "title": "Runtime rapido sin LLM",
      "gates": [
        {"metric": "llm_calls", "operator": "eq", "threshold": 0},
        {"metric": "simulated_latency_ms", "operator": "lte", "threshold": 20},
        {"metric": "deterministic_selection", "operator": "eq", "threshold": 1},
        {"metric": "baseline_available", "operator": "eq", "threshold": 1}
      ]
    },
    "R7": {
      "title": "Segundo proveedor stub",
      "gates": [
        {"metric": "before_uses_didact", "operator": "eq", "threshold": 1},
        {"metric": "after_uses_video", "operator": "eq", "threshold": 1},
        {"metric": "intent_schema_changes", "operator": "eq", "threshold": 0},
        {"metric": "resolver_changes", "operator": "eq", "threshold": 0}
      ]
    },
    "R8": {
      "title": "Migracion y regresion v1/v2",
      "gates": [
        {"metric": "delivery_matches", "operator": "eq", "threshold": 1},
        {"metric": "legacy_new_writes", "operator": "eq", "threshold": 0},
        {"metric": "historical_read_path", "operator": "eq", "threshold": 1}
      ]
    }
  }
}
