    {
      "domain_id": "sql",
      "title": "LEFT JOIN con valores NULL",
      "competency_contract": {
        "observable_outcome": "Construye y verifica una consulta que conserva todas las cuentas aunque no tengan pedidos.",
        "required_facts": [
          "sql.left_join_preserves_left_rows",
          "sql.where_on_right_can_drop_unmatched",
          "sql.null_uses_is_null",
          "sql.count_column_ignores_null"
        ],
        "required_evidence": [
          "query_executes",
          "expected_rows",
          "preserves_unmatched",
          "explains_null_behavior"
        ],
        "critical_errors": [
          "drops_unmatched_accounts",
          "uses_equals_null",
          "wrong_join_key",
          "passes_only_visible_case"
        ],
        "transfer_task_ref": "sql.transfer.unseen-null-distribution"
      },
      "source_affordance_map": {
        "source_ref": "synthetic-sql-join-null@1",
        "facts": {
          "sql.left_join_preserves_left_rows": "LEFT JOIN preserves rows from its left input when no right row matches.",
          "sql.where_on_right_can_drop_unmatched": "A rejecting WHERE predicate on a nullable right-side column can remove unmatched rows.",
          "sql.null_uses_is_null": "SQL tests NULL with IS NULL rather than equality to NULL.",
          "sql.count_column_ignores_null": "COUNT(column) ignores NULL values."
        },
        "affordances": [
          "inspect_schema",
          "write_query",
          "execute_query",
          "inspect_rows",
          "revise_query"
        ],
        "synthetic_schema": {
          "accounts": ["account_id", "name"],
          "orders": ["order_id", "account_id", "total"]
        },
        "synthetic_data": {
          "accounts": [[1, "A"], [2, "B"], [3, "C"]],
          "orders": [[101, 1, 10], [102, 1, null], [103, 3, 25], [104, null, 7]]
        }
      },
      "transfer_task": {
        "task_ref": "sql.transfer.unseen-null-distribution",
        "synthetic_case": true,
        "prompt": "Return every account and its order count for a new dataset containing accounts with zero, one and multiple orders.",
        "case_data": {
          "accounts": [[10, "J"], [11, "K"], [12, "L"], [13, "M"]],
          "orders": [[201, 10, 12], [202, 12, null], [203, 12, 18], [204, null, 5]]
        },
        "oracle": {
          "columns": ["account_id", "order_count"],
          "ordered_rows": [[10, 1], [11, 0], [12, 2], [13, 0]]
        }
      },
      "specimens": [
        {
          "path": "screen_scheme",
          "specimen_kind": "current-shape-reference",
          "claims": [
            {"text": "LEFT JOIN preserves left-side rows.", "fact_refs": ["sql.left_join_preserves_left_rows"]},
            {"text": "A right-side WHERE predicate may remove unmatched rows.", "fact_refs": ["sql.where_on_right_can_drop_unmatched"]},
            {"text": "Use IS NULL and remember COUNT(column) ignores NULL.", "fact_refs": ["sql.null_uses_is_null", "sql.count_column_ignores_null"]}
          ],
