# Editing rules for this file. Reject a change that breaks one:
# 1. One variable per line; one comment line per variable, or one per group.
# 2. Comment lines: 12 words or fewer. No sentence spans two lines.
# 3. No ASCII banners. A section header is one line: # ── Name ──
# 4. Any "why" longer than 12 words belongs in the reference page.
# 5. Five sections maximum.

# SkillNet. Copy to .env, fill in Required, then docker compose up -d.
# Every variable, its default and whether Docker passes it: docs/design/configuration.md
# How to start the project, step by step: RUNNING.md

# ── Required ──────────────────────────────────────────────────
# Generate each: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Letters, digits, `-` and `_` only: it lands in a URL unescaped.
POSTGRES_PASSWORD=
# Your AI provider key. Without it, generation comes back empty.
LLM_API_KEY=

# ── Model ─────────────────────────────────────────────────────
# Empty = gpt-4o-mini. Any litellm id, shaped provider/model.
LLM_MODEL=
# Empty = text-embedding-3-small. It must return 768 dimensions.
EMBEDDING_MODEL=

# ── Owner account ─────────────────────────────────────────────
# Blank = the /setup screen creates the owner in your browser.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ORG_NAME=SkillNet
# organization (company, team, class) or individual (one person alone).
WORKSPACE_MODE=organization

# ── Optional, uncomment what you need ─────────────────────────
# PORT=3000                        # host port for the interface
# COOKIE_SECURE=false              # overrides every exposure overlay
# DOMAIN=                          # required by the caddy overlay
# CADDY_EMAIL=                     # required by the caddy overlay
# CLOUDFLARE_TUNNEL_TOKEN=         # required by the cloudflared overlay
# TTS_PROVIDER=disabled            # openai, elevenlabs, google, azure
# TTS_API_KEY=                     # key for that TTS provider
# OPENROUTER_API_KEY=              # image generation (infographics, slides)
# IMAGE_API_KEY=                   # when images use another account
# VISION_MODEL=                    # describes images inside uploaded PDFs
# GOOGLE_CLIENT_ID=                # sign in with Google
# GOOGLE_CLIENT_SECRET=            # sign in with Google
# GOOGLE_REDIRECT_URI=             # must match Google's console verbatim
# RENDER_CACHE_SWEEP=true          # delete unreachable cached screens at startup
# A2A_INTERNAL_API_KEY=            # a2a profile: key for /ext/v1
# A2A_AUTH_KEY=                    # a2a profile: bearer token for callers

# Not listed here: retries, media models, Ollama, MCP, tuning dials.
# All of them: docs/design/configuration.md, with defaults and Docker reachability.
# Several settings never reach the container. That page says which.
