# SkillNet — Environment Configuration
# Copy this file to .env and fill in the required values.
#   cp .env.example .env
# Docs: https://github.com/ANFAIA/SkillNet

# ══════════════════════════════════════════════════════════════
# REQUIRED — SkillNet won't start without these
# ══════════════════════════════════════════════════════════════

# Secret key for signing sessions. Must be >= 32 characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Database password. Pick something strong.
#
# Letters, digits, `-` and `_` ONLY. This value is interpolated into a connection URL
# without escaping, so a `@`, `:`, `/`, `#` or `?` — exactly what a password manager
# produces — splits the URL, and the API then fails to reach the database with an error
# that never mentions the password.
POSTGRES_PASSWORD=

# ══════════════════════════════════════════════════════════════
# LLM PROVIDER — Configure for content generation + chat
# ══════════════════════════════════════════════════════════════
# THE MINIMUM: put an OpenAI key in LLM_API_KEY and touch nothing else in this section
# or the next one. The defaults (gpt-4o-mini and text-embedding-3-small) already match
# the database schema and both run off that same key.
#
# Any provider litellm supports works. The model id takes the form "provider/model":
# anthropic/claude-sonnet-4-20250514, deepseek/deepseek-chat, openai/gpt-4o (with
# LLM_BASE_URL for compatible endpoints), ollama/llama3.1. With no prefix, OpenAI is
# assumed.

LLM_BASE_URL=
LLM_API_KEY=
# Empty = gpt-4o-mini (the compose default). Set it only to use a different model.
LLM_MODEL=

# Optional per-purpose overrides (fall back to LLM_MODEL):
# LLM_GENERATION_MODEL=
# LLM_TUTOR_MODEL=
# LLM_EVAL_MODEL=

# Two-tier runtime router for dynamic courses. Both empty => both tiers use
# LLM_MODEL, which works fine. Any litellm model id; no provider is required.
# LLM_RUNTIME_FAST_MODEL=
# LLM_RUNTIME_HEAVY_MODEL=

# Generate each dynamic learning node as a grounded, domain-specific episode instead of
# applying the legacy lead/concept/practice screen formula. Safe to roll out per render:
# unsupported assessment stays explicitly unscored rather than inventing mastery.
# ADAPTIVE_EPISODES=false

# Force the onboarding wizard for learners without a completed profile (default true).
# Set to false while testing so new accounts land straight on their home (default
# profile bucket); they can still onboard later. Read by the SPA via /setup/status.
# ONBOARDING_ENABLED=true

# ══════════════════════════════════════════════════════════════
# VISION — For describing images in uploaded PDFs
# ══════════════════════════════════════════════════════════════
# Must be a multimodal model (supports image_url in messages). When empty,
# image description is disabled: PDFs are processed text-only, no error.
# Compatible models: gemini/gemini-2.5-flash, gpt-4o, gpt-4o-mini,
# claude-sonnet-4-20250514, any model litellm routes that accepts images.
# Uses the same API key and base URL as LLM unless overridden per org.
# VISION_MODEL=gemini/gemini-2.5-flash

# ══════════════════════════════════════════════════════════════
# EMBEDDINGS — For RAG / vector search (falls back to LLM provider)
# ══════════════════════════════════════════════════════════════
# Empty = same key and provider as the LLM, with text-embedding-3-small. Fill these in
# only if embeddings come from somewhere other than generation.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# Left active (not commented) to match LLM_MODEL above: the keyless path in RUNNING.md
# step 2 asks you to set BOTH to fixture/local, and having one of the pair commented out
# meant editing them in two different ways. Empty = text-embedding-3-small.
EMBEDDING_MODEL=
#
# EMBEDDING_DIMENSIONS **describes** the schema, it does not decide it: the
# document_chunks.embedding column is vector(768), fixed by migration 0008. This number
# has to match it or every chunk insert fails. Startup checks it and says so in plain
# words (and it shows in /health), instead of letting it blow up when the first document
# is ingested.
#
# So putting your model's native dimension here is NOT enough. Three cases:
#
#   * text-embedding-3-small / -large: they accept a `dimensions` parameter and the API
#     truncates for you. SkillNet sends it, so they return 768 and fit. Leave 768.
#   * A model whose native output is already 768 (multilingual-e5-base, nomic-embed-text,
#     paraphrase-multilingual): also fits. Leave 768.
#   * Any other dimension (multilingual-e5-small is 384, e5-large 1024): the column has
#     to be migrated and every document re-ingested. That is not an edit to this line.
EMBEDDING_DIMENSIONS=768

# ══════════════════════════════════════════════════════════════
# DYNAMIC COURSES (v2) — always available, per-course via delivery_mode
# ══════════════════════════════════════════════════════════════
# A course goes through v2 if it is delivery_mode='dynamic' AND
# schema_status='validated'; every other course stays on v1.

# UI dialect asked of the LLM and parser used. One valid value in this release.
# RENDER_BACKEND=openui
#
# Component selection runs after pedagogical gates and before renderer exposure.
# top5/v1 + live preserves the default runtime shortlist. progressive starts at
# top3; expansion requires an explicit caller/gate stage. dual-agent and
# conditional-specialist remain shadow-only until independent rankings exist.
# RUNTIME_SELECTION_STRATEGY=top5/v1
# RUNTIME_SELECTION_EXECUTION=live

# Recorded LLM fixtures — run the whole flow with no API keys.
# Set LLM_MODEL=fixture/local and EMBEDDING_MODEL=fixture/local to activate them.
# The directory lives inside the package so it ships in the Docker image.
# LLM_FIXTURE_DIR=src/llm/fixture_data
# replay = serve recorded pairs (default). record = call the real provider and
# write every (prompt, response) pair into LLM_FIXTURE_DIR.
# LLM_FIXTURE_MODE=replay

# ── Keyless demo API ──────────────────────────────────────────
#   docker compose --profile fixtures up -d db api-fixtures
# Same image as `api`, but every LLM and embedding call is served from the
# recorded fixtures above. It gets its own port because the bundled nginx SPA
# proxies to `api`; to run the WHOLE stack keyless instead, set
# LLM_MODEL/EMBEDDING_MODEL to fixture/local above.
# API_FIXTURES_PORT=8001

# Public demo dataset (see RUNNING.md):
#   docker compose exec api uv run python -m src.seed_learning_demo
# Idempotent. Seeds the "how we learn" courses and three demo learners.

# Tuning generation quality: docs/design/tuning.md
#   cd apps/skillnet-api && uv run python scripts/quality_bench.py --offline

# ══════════════════════════════════════════════════════════════
# TTS — Text-to-Speech (optional, disabled by default)
# ══════════════════════════════════════════════════════════════
# Providers: openai, elevenlabs, google, azure. "disabled" = no TTS.
# Drives the mascot's read-aloud voice AND the primary (natural, two-host) podcast voice.
# WITHOUT a working key / with no credits, two things degrade DIFFERENTLY:
#   * Mascot live voice (POST /api/v1/tts/synthesize) HARD-FAILS with 500 — it does NOT
#     fall back to the offline voice (known gap). The frontend swallows it silently: the
#     learner just gets no audio, not a broken screen.
#   * Podcast generation falls back ElevenLabs -> Azure (if configured) -> offline eSpeak NG,
#     so a podcast is always produced, but the offline voice is robotic.
# Media is baked at SEED TIME and stored (content-addressed): learners hear whatever voice
# was generated when the seed ran, not a per-user render.
# TTS_PROVIDER=disabled
# TTS_API_KEY=
# Empty voice selects the provider default. Azure defaults to es-ES-ElviraNeural.
# TTS_VOICE=
# TTS_LANGUAGE=es
# TTS_TIMEOUT_SECONDS=30
#
# Azure requires both the resource region and its full synthesis endpoint. They are
# deliberately not inferred so sovereign-cloud and private endpoints remain supported.
# Example endpoint:
# https://westeurope.tts.speech.microsoft.com/cognitiveservices/v1
# TTS_AZURE_REGION=westeurope
# TTS_AZURE_ENDPOINT=

# ══════════════════════════════════════════════════════════════
# IMAGES — Infographic / slide posters (optional)
# ══════════════════════════════════════════════════════════════
# Image generation for media artefacts (infographic poster, slide illustrations).
# Primary model is OpenRouter's Gemini image model; it needs OPENROUTER_API_KEY.
# The per-call fallback (gpt-image-1) uses the OpenAI LLM_API_KEY.
# WITHOUT a key, image generation is best-effort and degrades gracefully: the infographic
# is produced WITHOUT its poster image (has_image=false) and the job does NOT fail. Like
# audio, images are baked at seed time and shared by all learners.
# IMAGE_MODEL=openrouter/google/gemini-2.5-flash-image
# IMAGE_FALLBACK_MODEL=gpt-image-1
# OPENROUTER_API_KEY=

# ══════════════════════════════════════════════════════════════
# OWNER ACCOUNT + WORKSPACE MODE — how the deployment is set up
# ══════════════════════════════════════════════════════════════
# Two ways to initialize a fresh deployment. Pick one:
#
#  A) Headless (set the three values below). On first startup SkillNet creates the
#     owner account and fixes the mode — no browser step. This is the simplest path
#     to automate ("configure this for me").
#       · For a personal install:   WORKSPACE_MODE=individual  + your own ADMIN_* below
#       · For a company/team/class: WORKSPACE_MODE=organization + your own ADMIN_*
#
#  B) UI wizard: LEAVE ADMIN_EMAIL / ADMIN_PASSWORD BLANK. The first time you open
#     the app you get a /setup screen to choose the mode and create the owner.
#
# These ship BLANK on purpose, which selects path B: the first time you open the app you
# get the /setup screen and create your own owner account there. The alternative — shipping
# a working `admin` / `admin123` pair so the stack is browsable the second it boots — was
# the one dangerous default in this file that applied all by itself: copy the example,
# expose it with the Caddy overlay, and an owner account is on the public internet with a
# password everyone can read here.
#
# Filling them in is still the right move for an automated or repeatable install. If you
# do, use your own values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ORG_NAME=SkillNet
# 'organization' (company/team/class/academy) or 'individual' (one person who
# administers and learns alone — no employees, talent, assignments or org reports).
# Read only when the organization is first created; a stable per-deployment
# capability, never inferred from user count. See docs/design/audience-modes.md.
WORKSPACE_MODE=organization

# ══════════════════════════════════════════════════════════════
# OPTIONAL — Defaults are fine for most deployments
# ══════════════════════════════════════════════════════════════

# Port where SkillNet is accessible (default: 3000)
# PORT=3000

# Cookies over HTTPS only. Left COMMENTED on purpose, which is not the same as setting it
# to false: an explicit value here WINS over the exposure overlays, and all three of them
# (caddy, cloudflared, quicktunnel) default it to `true` precisely because they put real TLS
# in front. Shipping `COOKIE_SECURE=false` as an active line silently defeated that for
# everyone who copied this file — measured through a live public tunnel, where the session
# cookie came back with no `Secure` flag over HTTPS.
#
# Commented out, the base file's own default (false) still applies for plain-HTTP localhost,
# and the overlays can raise it. Set it explicitly only to override both.
# COOKIE_SECURE=false

# Allowed CORS origins (JSON array). With the bundled nginx proxy the
# frontend is same-origin, so this rarely needs changing.
# CORS_ORIGINS=["http://localhost:3000"]

# Database config (defaults match the db service)
# POSTGRES_USER=skillnet
# POSTGRES_DB=skillnet

# LOG_LEVEL=info
# ENVIRONMENT=production
# MAX_UPLOAD_SIZE_MB=50

# ══════════════════════════════════════════════════════════════
# A PUBLIC URL IN ONE COMMAND (optional, nothing to configure)
# ══════════════════════════════════════════════════════════════
#   docker compose -f docker-compose.yml -f docker-compose.quicktunnel.yml up -d --build
#   docker compose -f docker-compose.yml -f docker-compose.quicktunnel.yml logs quicktunnel
# Cloudflare hands back a random https://<words>.trycloudflare.com that works from any
# network, with no account, no domain and nothing opened on the router. There is nothing to
# set here — that is the point. The hostname is ephemeral and there is no access control in
# front of it, so it is for a demo today, not for a deployment. See RUNNING.md, "Letting
# other people in".

# ══════════════════════════════════════════════════════════════
# PUBLIC DOMAIN via CADDY (optional — see RUNNING.md,
# "Exposing SkillNet on your own domain")
# ══════════════════════════════════════════════════════════════
#   docker compose -f docker-compose.yml -f docker-compose.caddy.yml up -d --build
# Needs a domain whose DNS A record already points at this host's public IP, and ports
# 80/443 open on the router/firewall — Caddy answers Let's Encrypt's HTTP-01 challenge on
# 80 itself, so without that the certificate request just times out.

# Public hostname Caddy requests a Let's Encrypt certificate for. Required to use the
# caddy overlay; leaving it unset fails fast at `docker compose up` rather than issuing a
# cert for the wrong name.
# DOMAIN=

# Email Let's Encrypt attaches to the certificate account, for renewal and expiry
# notices. Required, not optional, to use the caddy overlay: Caddy's Caddyfile `email`
# directive has no "blank means skip it" syntax — an empty value is a parse error and
# caddy refuses to start at all, so this fails fast at `docker compose up` instead.
# CADDY_EMAIL=

# Once the domain is live behind Caddy's TLS, flip this on — see COOKIE_SECURE above.
# COOKIE_SECURE=true

# ══════════════════════════════════════════════════════════════
# PUBLIC EXPOSURE via CLOUDFLARE TUNNEL (optional, no router/firewall changes)
# ══════════════════════════════════════════════════════════════
#   docker compose -f docker-compose.yml -f docker-compose.cloudflared.yml up -d --build
# Alternative to the Caddy overlay above for when opening 80/443 on the router isn't
# possible or wanted: cloudflared dials out to Cloudflare's edge, so there is no inbound
# port and no public IP needed at all. Needs a free Cloudflare account with a domain
# added to it — create the tunnel in the Zero Trust dashboard under Networks > Tunnels,
# pick "Docker" as the connector, and it hands you the token below.

# Token for the named tunnel created above. Required to use the cloudflared overlay;
# leaving it unset fails fast at `docker compose up` rather than starting a container
# that can never authenticate.
# CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare terminates TLS at its edge and handles DNS for the tunnel hostname, same as
# Caddy does for its own domain — once traffic is genuinely arriving over HTTPS through
# the tunnel, flip this on too. See COOKIE_SECURE above.
# COOKIE_SECURE=true

# ══════════════════════════════════════════════════════════════
# A2A AGENT SERVER (optional — enable with: docker compose --profile a2a up)
# ══════════════════════════════════════════════════════════════
# Internal API key for the A2A server to call /ext/v1/ endpoints.
# Auto-created in the database on startup if set.
# Generate one: python -c "import secrets; print('sn_' + secrets.token_urlsafe(32))"
# A2A_INTERNAL_API_KEY=

# Bearer token external agents must provide to talk to the A2A server.
# A2A_AUTH_KEY=

# LLM model for the A2A orchestrator (defaults to gpt-4o-mini).
# A2A_LLM_MODEL=gpt-4o-mini
