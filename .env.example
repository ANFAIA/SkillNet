# SkillNet — Environment Configuration
# Copy this file to .env and fill in the required values.
#   cp .env.example .env
# Docs: https://github.com/ANFAIA/SkillNet

# ══════════════════════════════════════════════════════════════
# REQUIRED — SkillNet won't start without these
# ══════════════════════════════════════════════════════════════

# Secret key for signing sessions. Must be >= 32 characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Database password. Pick something strong.
POSTGRES_PASSWORD=

# ══════════════════════════════════════════════════════════════
# LLM PROVIDER — Configure for content generation + chat
# ══════════════════════════════════════════════════════════════
# Any provider litellm supports. Model uses the "provider/model" form,
# e.g. anthropic/claude-sonnet-4-20250514, deepseek/deepseek-chat,
# openai/gpt-4o (with LLM_BASE_URL for OpenAI-compatible endpoints),
# ollama/llama3.1.

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional per-purpose overrides (fall back to LLM_MODEL):
# LLM_GENERATION_MODEL=
# LLM_TUTOR_MODEL=
# LLM_EVAL_MODEL=

# ══════════════════════════════════════════════════════════════
# EMBEDDINGS — For RAG / vector search (falls back to LLM provider)
# ══════════════════════════════════════════════════════════════
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# MUST match your embedding model's output size — it is applied to the pgvector
# column when the schema is first created. Defaults to 384 (multilingual-e5-small).
# Examples: OpenAI text-embedding-3-small = 1536, multilingual-e5-large = 1024.
# Changing this AFTER the first run requires altering the column + reindexing +
# re-embedding existing documents, so set it correctly before the first startup.
EMBEDDING_DIMENSIONS=384

# ══════════════════════════════════════════════════════════════
# ADMIN ACCOUNT — created on first startup if set (headless setup)
# ══════════════════════════════════════════════════════════════
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=
ORG_NAME=Your Company

# ══════════════════════════════════════════════════════════════
# OPTIONAL — Defaults are fine for most deployments
# ══════════════════════════════════════════════════════════════

# Port where SkillNet is accessible (default: 3000)
# PORT=3000

# Cookies over HTTPS only. Set false for local HTTP; true behind TLS.
COOKIE_SECURE=false

# Allowed CORS origins (JSON array). With the bundled nginx proxy the
# frontend is same-origin, so this rarely needs changing.
# CORS_ORIGINS=["http://localhost:3000"]

# Database config (defaults match the db service)
# POSTGRES_USER=skillnet
# POSTGRES_DB=skillnet

# LOG_LEVEL=info
# ENVIRONMENT=production
# MAX_UPLOAD_SIZE_MB=50
