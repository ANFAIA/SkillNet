# SkillNet — Environment Configuration
# Copy this file to .env and fill in the required values.
#   cp .env.example .env
# Docs: https://github.com/ANFAIA/SkillNet

# ══════════════════════════════════════════════════════════════
# REQUIRED — SkillNet won't start without these
# ══════════════════════════════════════════════════════════════

# Secret key for signing sessions. Must be >= 32 characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Database password. Pick something strong.
POSTGRES_PASSWORD=

# ══════════════════════════════════════════════════════════════
# LLM PROVIDER — Configure for content generation + chat
# ══════════════════════════════════════════════════════════════
# LO MINIMO: pon una clave de OpenAI en LLM_API_KEY y no toques nada mas de esta
# seccion ni de la siguiente. Los modelos por defecto (gpt-4o-mini y
# text-embedding-3-small) ya cuadran con el esquema y con la misma clave.
#
# Cualquier proveedor que soporte litellm sirve. El modelo va en forma
# "proveedor/modelo": anthropic/claude-sonnet-4-20250514, deepseek/deepseek-chat,
# openai/gpt-4o (con LLM_BASE_URL para endpoints compatibles), ollama/llama3.1.
# Sin prefijo se asume OpenAI.

LLM_BASE_URL=
LLM_API_KEY=
# Vacio = gpt-4o-mini (el default del compose). Ponlo solo si quieres otro.
LLM_MODEL=

# Optional per-purpose overrides (fall back to LLM_MODEL):
# LLM_GENERATION_MODEL=
# LLM_TUTOR_MODEL=
# LLM_EVAL_MODEL=

# Two-tier runtime router for dynamic courses. Both empty => both tiers use
# LLM_MODEL, which works fine. Any litellm model id; no provider is required.
# LLM_RUNTIME_FAST_MODEL=
# LLM_RUNTIME_HEAVY_MODEL=

# Generate each dynamic learning node as a grounded, domain-specific episode instead of
# applying the legacy lead/concept/practice screen formula. Safe to roll out per render:
# unsupported assessment stays explicitly unscored rather than inventing mastery.
# ADAPTIVE_EPISODES=false

# ══════════════════════════════════════════════════════════════
# VISION — For describing images in uploaded PDFs
# ══════════════════════════════════════════════════════════════
# Must be a multimodal model (supports image_url in messages). When empty,
# image description is disabled: PDFs are processed text-only, no error.
# Compatible models: gemini/gemini-2.5-flash, gpt-4o, gpt-4o-mini,
# claude-sonnet-4-20250514, any model litellm routes that accepts images.
# Uses the same API key and base URL as LLM unless overridden per org.
# VISION_MODEL=gemini/gemini-2.5-flash

# ══════════════════════════════════════════════════════════════
# EMBEDDINGS — For RAG / vector search (falls back to LLM provider)
# ══════════════════════════════════════════════════════════════
# Vacios = misma clave y proveedor que el LLM, con text-embedding-3-small. Rellena
# solo si los embeddings vienen de otro sitio que la generacion.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
#
# EMBEDDING_DIMENSIONS **describe** el esquema, no lo decide: la columna
# document_chunks.embedding es vector(768), fijado en la migracion 0008. Este numero
# tiene que coincidir con ella, o cada insercion de chunk falla. El arranque lo
# comprueba y lo dice en claro (y sale en /health), en vez de dejarlo reventar al
# ingerir el primer documento.
#
# Por eso no basta con poner aqui la dimension nativa de tu modelo. Tres casos:
#
#   * text-embedding-3-small / -large: aceptan el parametro `dimensions` y la API los
#     recorta. SkillNet lo envia solo, asi que devuelven 768 y encajan. Deja el 768.
#   * Un modelo cuya salida nativa ya sea de 768 (multilingual-e5-base,
#     nomic-embed-text, paraphrase-multilingual): tambien encaja. Deja el 768.
#   * Cualquier otra dimension (multilingual-e5-small son 384, e5-large 1024): hay que
#     migrar la columna y reingerir los documentos. No es una edicion de esta linea.
EMBEDDING_DIMENSIONS=768

# ══════════════════════════════════════════════════════════════
# DYNAMIC COURSES (v2) — always available, per-course via delivery_mode
# ══════════════════════════════════════════════════════════════
# A course goes through v2 if it is delivery_mode='dynamic' AND
# schema_status='validated'; every other course stays on v1.

# UI dialect asked of the LLM and parser used. One valid value in this release.
# RENDER_BACKEND=openui
#
# Component selection runs after pedagogical gates and before renderer exposure.
# top5/v1 + live preserves the default runtime shortlist. progressive starts at
# top3; expansion requires an explicit caller/gate stage. dual-agent and
# conditional-specialist remain shadow-only until independent rankings exist.
# RUNTIME_SELECTION_STRATEGY=top5/v1
# RUNTIME_SELECTION_EXECUTION=live

# Recorded LLM fixtures — run the whole flow with no API keys.
# Set LLM_MODEL=fixture/local and EMBEDDING_MODEL=fixture/local to activate them.
# The directory lives inside the package so it ships in the Docker image.
# LLM_FIXTURE_DIR=src/llm/fixture_data
# replay = serve recorded pairs (default). record = call the real provider and
# write every (prompt, response) pair into LLM_FIXTURE_DIR.
# LLM_FIXTURE_MODE=replay

# ── Keyless demo API ──────────────────────────────────────────
#   docker compose --profile fixtures up -d db api-fixtures
# Same image as `api`, but every LLM and embedding call is served from the
# recorded fixtures above. It gets its own port because the bundled nginx SPA
# proxies to `api`; to run the WHOLE stack keyless instead, set
# LLM_MODEL/EMBEDDING_MODEL to fixture/local above.
# API_FIXTURES_PORT=8001

# Demo dataset for v2 (bakery-café org, 5 employees, 2 dynamic courses):
#   docker compose exec api uv run python -m src.seed_demo_v2
# Idempotent. `--refresh` re-applies edited node specs and bumps schema_version,
# which invalidates cached renders. Employee password: espiga2026.

# Tuning generation quality: docs/design/tuning.md
#   cd apps/skillnet-api && uv run python scripts/quality_bench.py --offline

# ══════════════════════════════════════════════════════════════
# TTS — Text-to-Speech (optional, disabled by default)
# ══════════════════════════════════════════════════════════════
# Providers: openai, elevenlabs, google, azure. "disabled" = no TTS.
# TTS_PROVIDER=disabled
# TTS_API_KEY=
# Empty voice selects the provider default. Azure defaults to es-ES-ElviraNeural.
# TTS_VOICE=
# TTS_LANGUAGE=es
# TTS_TIMEOUT_SECONDS=30
#
# Azure requires both the resource region and its full synthesis endpoint. They are
# deliberately not inferred so sovereign-cloud and private endpoints remain supported.
# Example endpoint:
# https://westeurope.tts.speech.microsoft.com/cognitiveservices/v1
# TTS_AZURE_REGION=westeurope
# TTS_AZURE_ENDPOINT=

# ══════════════════════════════════════════════════════════════
# OWNER ACCOUNT + WORKSPACE MODE — how the deployment is set up
# ══════════════════════════════════════════════════════════════
# Two ways to initialize a fresh deployment. Pick one:
#
#  A) Headless (set the three values below). On first startup SkillNet creates the
#     owner account and fixes the mode — no browser step. This is the simplest path
#     to automate ("configure this for me").
#       · For a personal install:   WORKSPACE_MODE=individual  + your own ADMIN_* below
#       · For a company/team/class: WORKSPACE_MODE=organization + your own ADMIN_*
#
#  B) UI wizard: LEAVE ADMIN_EMAIL / ADMIN_PASSWORD BLANK. The first time you open
#     the app you get a /setup screen to choose the mode and create the owner.
#
# The values below ship filled with demo credentials so `docker compose up` works
# out of the box for exploring — CHANGE them for any real deployment, or blank the
# ADMIN_* pair to get the wizard instead.
ADMIN_EMAIL=admin@skillnet.dev
ADMIN_PASSWORD=admin123
ORG_NAME=SkillNet Demo
# 'organization' (company/team/class/academy) or 'individual' (one person who
# administers and learns alone — no employees, talent, assignments or org reports).
# Read only when the organization is first created; a stable per-deployment
# capability, never inferred from user count. See docs/design/audience-modes.md.
WORKSPACE_MODE=organization

# ══════════════════════════════════════════════════════════════
# OPTIONAL — Defaults are fine for most deployments
# ══════════════════════════════════════════════════════════════

# Port where SkillNet is accessible (default: 3000)
# PORT=3000

# Cookies over HTTPS only. Set false for local HTTP; true behind TLS.
COOKIE_SECURE=false

# Allowed CORS origins (JSON array). With the bundled nginx proxy the
# frontend is same-origin, so this rarely needs changing.
# CORS_ORIGINS=["http://localhost:3000"]

# Database config (defaults match the db service)
# POSTGRES_USER=skillnet
# POSTGRES_DB=skillnet

# LOG_LEVEL=info
# ENVIRONMENT=production
# MAX_UPLOAD_SIZE_MB=50

# ══════════════════════════════════════════════════════════════
# A2A AGENT SERVER (optional — enable with: docker compose --profile a2a up)
# ══════════════════════════════════════════════════════════════
# Internal API key for the A2A server to call /ext/v1/ endpoints.
# Auto-created in the database on startup if set.
# Generate one: python -c "import secrets; print('sn_' + secrets.token_urlsafe(32))"
# A2A_INTERNAL_API_KEY=

# Bearer token external agents must provide to talk to the A2A server.
# A2A_AUTH_KEY=

# LLM model for the A2A orchestrator (defaults to gpt-4o-mini).
# A2A_LLM_MODEL=gpt-4o-mini
