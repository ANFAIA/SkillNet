# SkillNet — Environment Configuration
# Copy this file to .env and fill in the required values.
#   cp .env.example .env
# Docs: https://github.com/ANFAIA/SkillNet

# ══════════════════════════════════════════════════════════════
# REQUIRED — SkillNet won't start without these
# ══════════════════════════════════════════════════════════════

# Secret key for signing sessions. Must be >= 32 characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Database password. Letters, digits, `-` and `_` ONLY.
#
# Not a style preference: docker-compose.yml interpolates this straight into
#   postgresql+asyncpg://user:PASSWORD@db:5432/db
# without escaping, so a `@`, `:`, `/`, `#` or `?` — exactly what a password manager
# generates — splits the URL and the API cannot reach the database, with an error that
# never mentions the password.
# Generate a safe one: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# ══════════════════════════════════════════════════════════════
# LLM PROVIDER — Configure for content generation + chat
# ══════════════════════════════════════════════════════════════
# THE MINIMUM: put an OpenAI key in LLM_API_KEY and change nothing else in this section
# or the next one. The defaults (gpt-4o-mini and text-embedding-3-small) already match the
# database schema and both work off that one key.
#
# Any provider litellm supports works. The model id takes the "provider/model" form:
# anthropic/claude-sonnet-4-20250514, deepseek/deepseek-chat, groq/llama-3.1-8b-instant,
# openai/gpt-4o (with LLM_BASE_URL for OpenAI-compatible endpoints). No prefix means OpenAI.
#
# For a LOCAL model, do not hand-write these: use the overlay file, which sets the LLM and
# the embedding model together and points both at the right host.
#   docker compose -f docker-compose.yml -f docker-compose.ollama.yml up -d --build

LLM_BASE_URL=
LLM_API_KEY=
# Empty = gpt-4o-mini (the compose default). Set it only to pick something else.
LLM_MODEL=

# Optional per-purpose overrides (fall back to LLM_MODEL):
# LLM_GENERATION_MODEL=
# LLM_TUTOR_MODEL=
# LLM_EVAL_MODEL=

# Two-tier runtime router for dynamic courses. Both empty => both tiers use
# LLM_MODEL, which works fine. Any litellm model id; no provider is required.
# LLM_RUNTIME_FAST_MODEL=
# LLM_RUNTIME_HEAVY_MODEL=

# ══════════════════════════════════════════════════════════════
# EMBEDDINGS — For RAG / vector search (falls back to LLM provider)
# ══════════════════════════════════════════════════════════════
# Leave all three empty and embeddings use the same provider and key as the LLM, with
# text-embedding-3-small. Fill them in only if embeddings come from somewhere else than
# generation.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
#
# EMBEDDING_DIMENSIONS **describes** the schema, it does not decide it:
# document_chunks.embedding is vector(768), pinned in migration 0008. This number has to
# match the column or every chunk insert fails — and it fails *quietly*, inside the
# ingestion `except`, leaving a document marked READY that no search can retrieve. Startup
# checks it and says so in plain words, and GET /health reports it.
#
# So putting your model's native size here is not enough. Three cases:
#
#   * text-embedding-3-small / -large: they accept the `dimensions` parameter and the API
#     truncates for you. SkillNet sends it, so they return 768 and fit. Keep 768.
#   * A model whose native output is already 768 (multilingual-e5-base, nomic-embed-text,
#     paraphrase-multilingual): also fits. Keep 768.
#   * Any other size (multilingual-e5-small is 384, e5-large is 1024): that needs a column
#     migration and a re-ingestion of every document. It is not an edit to this line.
EMBEDDING_DIMENSIONS=768

# ══════════════════════════════════════════════════════════════
# DYNAMIC COURSES (v2)
# ══════════════════════════════════════════════════════════════
# The code default is `off` (src/config.py), so an upgrade that sets nothing behaves
# exactly as before. THIS FILE sets `on`, because a fresh install wants the full product.
#
# off    = every v2 route returns 404, delivery_mode is ignored.
# shadow = admin-only: propose/edit/validate a schema and preview renders with
#          ?preview=1. Employees still see v1. This is what the dev overlay sets.
# on     = full v2. A course only goes through v2 if it is delivery_mode='dynamic'
#          AND schema_status='validated'; every other course stays on v1.
DYNAMIC_COURSES_MODE=on

# UI dialect asked of the LLM and parser used. One valid value in this release.
# RENDER_BACKEND=openui

# Recorded LLM fixtures — run the whole flow with no API keys.
# Set LLM_MODEL=fixture/local and EMBEDDING_MODEL=fixture/local to activate them.
# The directory lives inside the package so it ships in the Docker image.
# LLM_FIXTURE_DIR=src/llm/fixture_data
# replay = serve recorded pairs (default). record = call the real provider and
# write every (prompt, response) pair into LLM_FIXTURE_DIR.
# LLM_FIXTURE_MODE=replay

# ── Keyless demo API ──────────────────────────────────────────
#   docker compose --profile fixtures up -d db api-fixtures
# Same image as `api`, but every LLM and embedding call is served from the
# recorded fixtures above and DYNAMIC_COURSES_MODE is forced to `on`. It gets
# its own port because the bundled nginx SPA proxies to `api`; to run the WHOLE
# stack keyless instead, set LLM_MODEL/EMBEDDING_MODEL to fixture/local above.
# API_FIXTURES_PORT=8001

# Demo dataset for v2 (bakery-café org, 5 employees, 2 dynamic courses):
#   docker compose exec api uv run python -m src.seed_demo_v2
# Idempotent. `--refresh` re-applies edited node specs and bumps schema_version,
# which invalidates cached renders. Employee password: espiga2026.

# Tuning generation quality: docs/design/tuning.md
#   cd apps/skillnet-api && uv run python scripts/quality_bench.py --offline

# ══════════════════════════════════════════════════════════════
# ADMIN ACCOUNT — created on first startup if set (headless setup)
# ══════════════════════════════════════════════════════════════
# Ready-to-use demo credentials — change in production.
ADMIN_EMAIL=admin@skillnet.dev
ADMIN_PASSWORD=admin123
ORG_NAME=SkillNet Demo

# ══════════════════════════════════════════════════════════════
# OPTIONAL — Defaults are fine for most deployments
# ══════════════════════════════════════════════════════════════

# Port where SkillNet is accessible (default: 3000)
# PORT=3000

# Cookies over HTTPS only. Set false for local HTTP; true behind TLS.
COOKIE_SECURE=false

# Allowed CORS origins (JSON array). With the bundled nginx proxy the
# frontend is same-origin, so this rarely needs changing.
# CORS_ORIGINS=["http://localhost:3000"]

# Database config (defaults match the db service)
# POSTGRES_USER=skillnet
# POSTGRES_DB=skillnet

# LOG_LEVEL=info
# ENVIRONMENT=production
# MAX_UPLOAD_SIZE_MB=50

# ══════════════════════════════════════════════════════════════
# A2A AGENT SERVER (optional — enable with: docker compose --profile a2a up)
# ══════════════════════════════════════════════════════════════
# Internal API key for the A2A server to call /ext/v1/ endpoints.
# Auto-created in the database on startup if set.
# Generate one: python -c "import secrets; print('sn_' + secrets.token_urlsafe(32))"
# A2A_INTERNAL_API_KEY=

# Bearer token external agents must provide to talk to the A2A server.
# A2A_AUTH_KEY=

# LLM model for the A2A orchestrator (defaults to gpt-4o-mini).
# A2A_LLM_MODEL=gpt-4o-mini
