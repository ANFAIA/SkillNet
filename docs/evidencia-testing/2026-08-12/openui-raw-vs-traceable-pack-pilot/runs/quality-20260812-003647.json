            "sources": [
              "source:bbbbbbbb-0000-0000-0000-000000000004:node:966d3494-bfca-586b-b90f-e7d1354df30a"
            ],
            "text": "Un fondo que no cuadra a la apertura es del turno anterior, y solo se puede reclamar antes de hacer la primera venta."
          },
          {
            "atom_id": "must.atom_004",
            "critical": true,
            "evidence": [],
            "kind": "safety_rule",
            "source_units": [
              "unit.004"
            ],
