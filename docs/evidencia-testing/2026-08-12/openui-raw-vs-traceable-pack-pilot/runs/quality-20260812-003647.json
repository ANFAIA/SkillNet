            ],
            "text": "Retirada de efectivo cada vez que la caja supera 600 euros: se mete en el buzon de seguridad con su sobre numerado."
          },
          {
            "atom_id": "must.atom_005",
            "critical": true,
            "evidence": [],
            "kind": "safety_rule",
            "source_units": [
              "unit.005"
            ],
            "sources": [
              "source:bbbbbbbb-0000-0000-0000-000000000004:node:966d3494-bfca-586b-b90f-e7d1354df30a"
            ],
            "text": "No se guardan billetes de 200 y 500 en el cajon: van directos al buzon."
          },
          {
            "atom_id": "must.atom_006",
            "critical": true,
            "evidence": [],
            "kind": "procedure_step",
            "source_units": [
