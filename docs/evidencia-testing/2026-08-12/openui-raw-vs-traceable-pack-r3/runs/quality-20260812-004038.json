            ],
            "text": "Retirada de efectivo cada vez que la caja supera 600 euros: se mete en el buzon de seguridad con su sobre numerado."
          },
          {
            "atom_id": "must.atom_005",
            "critical": true,
            "evidence": [],
            "kind": "safety_rule",
            "source_units": [
              "unit.005"
