              "source:bbbbbbbb-0000-0000-0000-000000000004:node:966d3494-bfca-586b-b90f-e7d1354df30a"
            ],
            "text": "Se cuenta delante del encargado y se firma la hoja de apertura."
          },
          {
            "atom_id": "must.atom_003",
            "critical": true,
            "evidence": [],
            "kind": "procedure_step",
            "source_units": [
              "unit.003"
            ],
            "sources": [
